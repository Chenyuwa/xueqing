function zs(e){ // 相对同学的位置(标准分)：排名换算为正态分数，排除试卷难度
 const p=[];
 if(e.gr&&e.gn>1)p.push([probit((e.gn-e.gr+.5)/e.gn),2]);
 if(e.cr&&e.cn>1)p.push([probit((e.cn-e.cr+.5)/e.cn),e.gr?1:2]);
 if(e.avg)p.push([Math.max(-3,Math.min(3,(e.score-e.avg)/(.15*e.full))),1]);
