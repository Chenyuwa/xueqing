 if(n<2)return h+`<div class="mute">${asub}至少需要2次带“考试范围”且范围有重叠的记录，才能推断薄弱章节。当前 ${n} 次。</div></div>`;
 const W=weak(asub);
 h+=`<b>最该先复习</b>${W.slice(0,5).map((w,i)=>`<div>${i+1}. ${w.name}<span class="mute"> ${w.vol} · 掌握约${pc(w.mas)}${w.days==null?"，从未考过":"，"+Math.round(w.days)+"天前考过"}</span></div>`).join("")}<div class="mute" style="margin-top:6px">掌握度≈该章相对同学的百分位，由多次考试范围的重叠和失分反推；置信度低说明这章总是和别的章一起出现，无法单独区分，请当参考。</div></div>`;
 [["薄弱",w=>w.mas<.45,"var(--dn)"],["一般",w=>w.mas>=.45&&w.mas<.65,"#ca8a04"],["较好",w=>w.mas>=.65,"var(--up)"]].forEach(([nm,f,c])=>{const a=W.filter(f);if(!a.length)return;
  h+=`<h2 style="color:${c}">${nm}（${a.length}章）</h2>`+a.map(w=>`<div class="card"><div class="row"><span>${w.name}</span><span class="mute">${pc(w.mas)} · 置信度${w.conf<.2?"无":w.conf<.45?"低":w.conf<.6?"中":"高"}</span></div><div class="bar"><i style="width:${w.mas*100}%;background:${c}"></i></div></div>`).join("")});
 return h}
function plan(){
 S.goal=S.goal||{};
 let h=`<h1>计划</h1><div class="card"><b>目标分</b>`+SUBS.map(s=>{const L=list(s),e=L[L.length-1],g=S.goal[s],gap=e&&g?g-e.score:null;
  return`<div class="row" style="margin-top:8px"><span>${s}</span><span><input style="width:84px" type="number" value="${g||""}" placeholder="目标分" onchange="S.goal['${s}']=+this.value;save();render()"> <span class="${gap>0?"dn":"up"}">${gap==null?"":gap>0?"差"+gap+"分":"已达成"}</span></span></div>`+(gap>0&&L.length>1?`<div class="mute">优先补：${weak(s).slice(0,2).map(w=>w.name).join("、")}</div>`:"")}).join("")+`</div>
 <div class="card"><b>下次考试</b><div class="g2"><div><label>科目</label><select onchange="asub=this.value;scopeUI()">${SUBS.map(s=>`<option ${s==asub?"selected":""}>${s}</option>`).join("")}</select></div><div><label>日期</label><input id="n_date" type="date" value="${S.next?S.next.date:""}"></div></div><label>范围</label><div id="scope"></div><button class="btn" onclick="saveNext()">生成复习计划</button></div>`;
 const nx=S.next;if(!nx)return h;
 const days=Math.ceil((new Date(nx.date)-Date.now())/864e5);
 if(days<0)return h+`<div class="card mute">上次设置的考试日期已过，请重新设置。</div>`;
 const D=Math.max(1,days-1),W=weak(nx.sub).filter(w=>nx.scope.includes(w.k)),tw=W.reduce((a,w)=>a+w.pri,0)||1;let d=1;
 h+=`<div class="card"><div class="row"><b>${nx.sub} 考试倒计时</b><b class="${days<4?"dn":""}">${days} 天</b></div>`+W.map(w=>{const k=Math.max(1,Math.round(D*w.pri/tw)),r=`第${d}${k>1?"-"+(d+k-1):""}天`;d+=k;return`<div style="margin-top:12px"><div class="row"><b>${w.name}</b><span class="mute">${r}</span></div>${kpHtml(nx.sub,w.k)}</div>`}).join("")+`<div class="row" style="margin-top:6px"><span class="mute">考前一天</span><span>整卷回顾 + 错题</span></div>${d-1>D?`<div class="dn">时间偏紧，先完成前面的章节。</div>`:""}<div class="mute">越薄弱、越久没考的章节分到的天数越多。</div></div>`;
 return h}
function saveNext(){const d=$("#n_date").value;if(!d)return alert("请选择考试日期");S.next={sub:asub,date:d,scope:[...document.querySelectorAll("#scope input:checked")].map(c=>c.value)};save();render()}
const kpOf=(sub,key)=>((KP[sub]||{})[key.split("|")[1]]||"").split("、").filter(Boolean);
function kpHtml(sub,key){return`<div class="chips" style="margin:6px 0 0">`+kpOf(sub,key).map(t=>`<span class="pill">${t}</span>`).join("")+`</div>`}
function kbSave(){S.kb={K,KP};save()}
function kb(){let h=`<h1>知识点</h1><div class="card"><div class="chips">${SUBS.map(s=>`<button class="pill ${s==asub?"on":""}" onclick="asub='${s}';render()">${s}</button>`).join("")}</div><div class="mute">考点用“、”分隔，★表示高频。学校进度不同可以增删改。内置考点依据课程标准与人教版教材整理，请对照学校进度核对。</div></div>`;
 Object.entries(K[asub]).forEach(([v,l])=>{h+=`<h2>${v}</h2>`+l.map(n=>`<div class="card"><div class="row"><b>${n}</b><button class="btn s" onclick="kbDel('${v}','${n}')">删除</button></div><input value="${((KP[asub]||{})[n]||"").replace(/"/g,"&quot;")}" onchange="(KP[asub]=KP[asub]||{})['${n}']=this.value;kbSave()"></div>`).join("")});
 return h+`<div class="card"><b>新增章节</b><input id="k_vol" placeholder="册，如 必修第一册"><input id="k_name" placeholder="章名" style="margin-top:6px"><button class="btn" onclick="kbAdd()">添加</button></div><button class="btn s" onclick="if(confirm('恢复内置知识点？')){delete S.kb;save();location.reload()}">恢复默认</button>`}
function kbAdd(){const v=$("#k_vol").value.trim(),n=$("#k_name").value.trim();if(!v||!n)return alert("请填写册和章名");(K[asub][v]=K[asub][v]||[]).push(n);kbSave();render()}
function kbDel(v,n){if(confirm("删除章节？已有成绩记录不受影响")){K[asub][v]=K[asub][v].filter(x=>x!=n);if(!K[asub][v].length)delete K[asub][v];kbSave();render()}}
function csv(){const r=[["科目","日期","类型","得分","满分","班排","班级人数","年排","年级人数","班均分"],...S.exams.map(e=>[e.sub,e.date,e.type,e.score,e.full,e.cr,e.cn,e.gr,e.gn,e.avg].map(x=>x??""))];const a=document.createElement("a");a.href=URL.createObjectURL(new Blob(["\ufeff"+r.map(x=>x.join(",")).join("\n")],{type:"text/csv"}));a.download="成绩.csv";a.click()}
render();
if("serviceWorker"in navigator&&location.protocol.startsWith("http"))navigator.serviceWorker.register("sw.js");
</script></body></html>
