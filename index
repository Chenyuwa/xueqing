function weak(sub){ // 加权岭回归(贝叶斯)：由考试范围与失分反推各章掌握度，并给出后验置信度
 const ks=keys(sub),idx={};ks.forEach((k,i)=>idx[k]=i);const N=ks.length,L=list(sub),ex=L.filter(e=>e.scope&&e.scope.length),now=Date.now(),last={};
