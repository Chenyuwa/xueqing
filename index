function trend(sub){
 const L=list(sub),n=L.length;if(n<2)return{k:"数据不足",c:"mute",t:"至少录入2次考试才能判断趋势",d:0};
 const z=L.map(zs),t=L.map(e=>new Date(e.date)/864e5),T=t[n-1],span=T-t[0]||1,ww=L.map((e,i)=>tw(e)*Math.pow(.5,(T-t[i])/45)),lvl=ww.reduce((a,x,i)=>a+x*z[i],0)/ww.reduce((a,x)=>a+x,0);
