 const A=Array.from({length:N},(_,i)=>Array.from({length:N},(_,j)=>i==j?LAM:0)),b=Array(N).fill(LAM*prior);
 const add=(row,y,w)=>{for(const i in row){for(const j in row)A[i][j]+=w*row[i]*row[j];b[i]+=w*row[i]*y}};
 ex.forEach(e=>{const sc=e.scope.filter(k=>k in idx);if(!sc.length)return;const w=tw(e)*Math.pow(.5,(now-new Date(e.date))/864e5/120),z=zs(e),row={};
