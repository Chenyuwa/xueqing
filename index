 const d=n>=3?.6*ch+.4*sl*span:ch,th=Math.max(.35,.9*noise),sg=Math.max(.8,2*noise);let r;
 if(n>=4&&vol>.9)r={k:"波动大",c:"dn",t:`相邻两次考试位置平均相差${vol.toFixed(1)}个标准差，状态不稳定`};
 else if(d<-sg)r={k:"显著下滑",c:"dn",t:"相对同学的位置明显下降，需要重点关注"};
 else if(d<-th)r={k:"下降",c:"dn",t:"相对位置在下滑"};
 else if(d>th)r={k:"上升",c:"up",t:"相对位置在提升"};
 else r={k:"持平",c:"mute",t:"相对位置基本稳定，变化在正常波动范围内"};
 r.d=d;
 if(n>=3){const mid=.5*lvl+.5*z[n-1]+.5*sl*span/(n-1),lo=Phi(mid-1.28*noise),hi=Phi(mid+1.28*noise),g=L[n-1].gn;r.pr=`下次预计相对位置 ${pc(lo)}–${pc(hi)}（80%区间）`+(g?`，约年排 ${Math.max(1,Math.round((1-hi)*g))}–${Math.round((1-lo)*g)} 名`:"")}
